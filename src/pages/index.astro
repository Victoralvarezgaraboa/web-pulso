---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Problema from '../components/Problema.astro';
import Metricas from '../components/Metricas.astro';
import Panel from '../components/Panel.astro';
import Herramientas from '../components/Herramientas.astro';
import Demos from '../components/Demos.astro';
import Arquitectura from '../components/Arquitectura.astro';
import Casos from '../components/Casos.astro';
import Precio from '../components/Precio.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
import LatidoPuntero from '../components/LatidoPuntero.astro';
---

<Base
  titulo="Pulso · Control de gestión para negocios pequeños"
  descripcion="EBITDA, margen y punto de equilibrio de tu negocio, cada mes y en castellano. Más las herramientas que hacen falta para arreglarlo: generadores de presupuestos, control de compras y paneles por sector."
>
  <Nav />
  <main>
    <Hero />
    <Problema />
    <Metricas />
    <Panel />
    <Herramientas />
    <Demos />
    <Arquitectura />
    <Casos />
    <Precio />
    <CtaFinal />
  </main>
  <Footer />
  <LatidoPuntero />
</Base>
