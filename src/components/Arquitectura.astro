---
/**
 * Cómo funciona por dentro. Todo lo que se afirma aquí es cierto y verificable
 * en la arquitectura real: servicios en Frankfurt, acceso con contraseña
 * cifrada, aislamiento por cliente y panel de solo lectura.
 */

const pasos = [
  {
    n: '01',
    titulo: 'Tu Excel de control',
    texto:
      'Una hoja diseñada para tu sector, con tus partidas y tus precios. Es nuestra mesa de trabajo, no la tuya: los datos los metemos y los cuadramos nosotros.',
  },
  {
    n: '02',
    titulo: 'Se publica al panel',
    texto:
      'Subimos la hoja y el cierre queda publicado al instante. Un backend propio valida, calcula y guarda; nada se copia a mano dos veces.',
  },
  {
    n: '03',
    titulo: 'Tú solo consultas',
    texto:
      'Entras con tu usuario y ves tu cierre. Solo lectura, a propósito: si el cliente pudiera tocar los números, el panel dejaría de ser una fuente fiable.',
  },
];

const garantias = [
  {
    titulo: 'Tus datos no salen de la Unión Europea',
    texto: 'Todos los servicios están desplegados en Fráncfort. Es una decisión de RGPD, no una casualidad.',
  },
  {
    titulo: 'Cada cliente, aislado',
    texto: 'Acceso con contraseña cifrada y sesión propia. Ningún cliente puede ver los datos de otro.',
  },
  {
    titulo: 'No tocamos tus bancos',
    texto: 'Pulso no es tu gestoría ni firma nada por ti. Analizamos; decidir y declarar sigue siendo tuyo.',
  },
];
---

<section id="metodo">
  <div class="wrap">
    <p class="sec-label" data-anim>06 · Cómo funciona</p>
    <h2 data-anim>Tres pasos. Solo uno es tuyo, y es el fácil.</h2>

    <div class="flujo" data-anim-grupo>
      {
        pasos.map((p, i) => (
          <article class="paso">
            <div class="cabecera">
              <span class="numero mono">{p.n}</span>
              {i < pasos.length - 1 && (
                <svg class="flecha" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path
                    d="M4 10h12M12 6l4 4-4 4"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              )}
            </div>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </article>
        ))
      }
    </div>

    <div class="garantias" data-anim-grupo>
      {
        garantias.map((g) => (
          <div class="garantia">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M12 3l7 3v6c0 4.4-2.9 7.9-7 9-4.1-1.1-7-4.6-7-9V6l7-3z"
                stroke="var(--pulso)"
                stroke-width="1.5"
                stroke-linejoin="round"
              />
              <path
                d="M9 12l2 2 4-4"
                stroke="var(--pulso)"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <div>
              <h4>{g.titulo}</h4>
              <p>{g.texto}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  h2 {
    max-width: 22ch;
    margin-bottom: 48px;
  }

  .flujo {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 20px;
  }

  .paso {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 30px;
  }

  .cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }
  .numero {
    font-size: 30px;
    color: var(--pulso);
    line-height: 1;
  }
  .flecha {
    color: var(--muted2);
  }

  .paso h3 {
    font-size: 22px;
    margin-bottom: 10px;
  }
  .paso p {
    font-size: 16px;
    color: var(--muted);
    text-wrap: pretty;
  }

  .garantias {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .garantia {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    background: var(--ink2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
  }
  .garantia svg {
    flex-shrink: 0;
    margin-top: 2px;
  }
  .garantia h4 {
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 6px;
    line-height: 1.35;
  }
  .garantia p {
    font-size: 15px;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .flujo,
    .garantias {
      grid-template-columns: 1fr;
    }
    .flecha {
      transform: rotate(90deg);
    }
  }
</style>
