---
import Latido from './Latido.astro';

/**
 * La radiografía económica: de la facturación al EBITDA.
 *
 * Las cifras son de ejemplo, pero CUADRAN entre sí (facturación − coste
 * directo = margen bruto; margen bruto − gastos fijos = EBITDA; los cuatro
 * trimestres suman el año). Quien entiende de números las va a sumar, y unas
 * cuentas que no cuadran destruyen justo la credibilidad que busca la página.
 */

const FACTURACION = 218400;
const COSTE_DIRECTO = 61150;
const MARGEN_BRUTO = FACTURACION - COSTE_DIRECTO; // 157.250
const GASTOS_FIJOS = 118900;
const EBITDA = MARGEN_BRUTO - GASTOS_FIJOS; // 38.350

const pct = (v: number) => ((v / FACTURACION) * 100).toFixed(1).replace('.', ',');

/** Facturación mínima para cubrir los gastos fijos con este margen. */
const EQUILIBRIO = Math.round(GASTOS_FIJOS / (MARGEN_BRUTO / FACTURACION));

const cuenta = [
  { concepto: 'Facturación', valor: FACTURACION, tipo: 'entrada', nota: 'Cuotas, bonos y nevera' },
  { concepto: 'Coste directo', valor: -COSTE_DIRECTO, tipo: 'resta', nota: 'Lo que sube al vender más' },
  { concepto: 'Margen bruto', valor: MARGEN_BRUTO, tipo: 'subtotal', nota: `${pct(MARGEN_BRUTO)}% de la facturación` },
  { concepto: 'Gastos fijos', valor: -GASTOS_FIJOS, tipo: 'resta', nota: 'Local, personal, suministros' },
  { concepto: 'EBITDA', valor: EBITDA, tipo: 'total', nota: `${pct(EBITDA)}% de la facturación` },
];

const trimestres = [
  { t: 'T1', ingresos: 61200, ebitda: 14800, nota: 'Propósitos de año nuevo' },
  { t: 'T2', ingresos: 57400, ebitda: 11200, nota: 'Ritmo estable' },
  { t: 'T3', ingresos: 42300, ebitda: -3900, nota: 'El verano vacía el local' },
  { t: 'T4', ingresos: 57500, ebitda: 16250, nota: 'Vuelta a la rutina' },
];

const acciones = [
  'Renegociar el pedido de bebidas: pagas un 9% más que en enero.',
  'Cubrir el agujero de T3 con bonos de verano vendidos en junio.',
  'Llamar a los 6 socios que llevan 3 semanas sin aparecer.',
];

const euros = (n: number) => `${n.toLocaleString('es-ES')} €`;

/** Alto de cada barra del gráfico trimestral, en porcentaje. */
const maxIngresos = Math.max(...trimestres.map((q) => q.ingresos));
---

<section id="panel">
  <div class="wrap">
    <p class="sec-label" data-anim>03 · El panel</p>
    <h2 data-anim>De la facturación al beneficio real</h2>
    <p class="bajada" data-anim>
      Esto es lo que ve un cliente al entrar. Solo lectura: sin campos que rellenar, sin menús que
      aprender. <strong>Cifras de ejemplo</strong>, panel real.
    </p>

    <div class="marco" data-anim>
      <div class="cabecera">
        <div class="titulo">
          <Latido tamano={20} />
          <span class="serif">Radiografía económica · año en curso</span>
        </div>
        <span class="mono sello">actualizado el 03/06</span>
      </div>

      <!-- ---------- Cuenta de resultados ---------- -->
      <div class="cuerpo">
        <div class="cuenta">
          {
            cuenta.map((f) => (
              <div class:list={['fila', f.tipo]}>
                <div class="concepto">
                  <span class="nombre">{f.concepto}</span>
                  <span class="nota">{f.nota}</span>
                </div>
                <span
                  class="importe mono"
                  data-contador={Math.abs(f.valor)}
                  data-decimales="0"
                  data-prefijo={f.valor < 0 ? '− ' : ''}
                  data-sufijo=" €"
                >
                  {f.valor < 0 ? '− ' : ''}
                  {euros(Math.abs(f.valor))}
                </span>
              </div>
            ))
          }
        </div>

        <aside class="lateral">
          <div class="dato">
            <p class="rotulo">Punto de equilibrio</p>
            <p class="cifra mono">{euros(EQUILIBRIO)}</p>
            <p class="pie">
              Por debajo de esta facturación, el año cierra en pérdidas. Vas <strong
                >{euros(FACTURACION - EQUILIBRIO)}</strong
              > por encima.
            </p>
          </div>

          <div class="dato">
            <p class="rotulo">Valoración orientativa</p>
            <p class="cifra mono">{euros(EBITDA * 3 + 42000)}</p>
            <p class="pie">EBITDA × 3 más equipamiento. Orientativa: no es una tasación.</p>
          </div>

          <div class="dato alerta">
            <p class="rotulo">Fuga detectada</p>
            <p class="cifra mono coral">− 612 €/mes</p>
            <p class="pie">Proveedor de bebidas: subió precio en marzo y nadie lo revisó.</p>
          </div>
        </aside>
      </div>

      <!-- ---------- Trimestres ---------- -->
      <div class="trimestres">
        <div class="encabezado-bloque">
          <h3 class="serif">Por trimestres</h3>
          <p class="ps">
            La estacionalidad manda. El verano no es un mal mes: es un agujero de
            <strong>{euros(Math.abs(trimestres[2].ebitda))}</strong> que hay que financiar con lo que
            gana el resto del año.
          </p>
        </div>

        <div class="qgrid">
          {
            trimestres.map((q) => (
              <div class:list={['q', q.ebitda < 0 ? 'perdidas' : '']}>
                <div class="qcabecera">
                  <span class="mono qt">{q.t}</span>
                  <span class:list={['mono qebitda', q.ebitda < 0 ? 'coral' : 'verde']}>
                    {q.ebitda < 0 ? '− ' : '+ '}
                    {euros(Math.abs(q.ebitda))}
                  </span>
                </div>
                <div class="barra" style={`--alto:${(q.ingresos / maxIngresos) * 100}%`}>
                  <span />
                </div>
                <p class="qingresos mono">{euros(q.ingresos)}</p>
                <p class="qnota">{q.nota}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- ---------- Acciones ---------- -->
      <div class="acciones">
        <p class="rotulo">Tus 3 acciones de este mes</p>
        <ol>
          {
            acciones.map((a, i) => (
              <li>
                <span class="mono orden">{String(i + 1).padStart(2, '0')}</span>
                <span>{a}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  h2 {
    max-width: 18ch;
    margin-bottom: 20px;
  }
  .bajada {
    font-size: 18px;
    color: var(--muted);
    max-width: 60ch;
    margin-bottom: 44px;
  }
  .bajada strong {
    color: var(--ivory);
    font-weight: 600;
  }

  .marco {
    background: var(--ink2);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: clamp(18px, 3vw, 32px);
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.45);
  }

  .cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 22px;
    margin-bottom: 26px;
    border-bottom: 1px solid var(--line);
  }
  .titulo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 19px;
    font-weight: 600;
  }
  .sello {
    font-size: 12px;
    color: var(--muted2);
    white-space: nowrap;
  }

  .cuerpo {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 20px;
    margin-bottom: 26px;
  }

  /* ---------- cuenta de resultados ---------- */
  .cuenta {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 10px 24px;
  }

  .fila {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .fila:last-child {
    border-bottom: none;
  }

  .concepto {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .nombre {
    font-size: 16px;
  }
  .nota {
    font-size: 13px;
    color: var(--muted2);
  }

  .importe {
    font-size: 19px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .fila.resta .importe,
  .fila.resta .nombre {
    color: var(--muted);
  }

  /* El subtotal y el total se separan visualmente: son las dos cifras que
     de verdad hay que leer. */
  .fila.subtotal {
    border-top: 1px solid rgba(236, 239, 234, 0.18);
  }
  .fila.subtotal .nombre,
  .fila.subtotal .importe {
    font-weight: 600;
  }

  .fila.total {
    border-top: 1px solid var(--pulso);
    margin-top: 2px;
  }
  .fila.total .nombre {
    font-family: var(--serif);
    font-size: 22px;
  }
  .fila.total .importe {
    font-size: 28px;
    color: var(--pulso);
  }

  /* ---------- lateral ---------- */
  .lateral {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .dato {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 20px 22px;
    flex: 1;
  }
  .dato.alerta {
    border-color: rgba(208, 132, 104, 0.35);
  }

  .rotulo {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 8px;
  }

  .cifra {
    font-size: 24px;
    line-height: 1.15;
    margin-bottom: 8px;
    font-variant-numeric: tabular-nums;
  }
  .cifra.coral {
    color: var(--coral);
  }

  .pie {
    font-size: 13px;
    color: var(--muted2);
    line-height: 1.5;
  }
  .pie strong {
    color: var(--pulso);
    font-weight: 600;
  }

  /* ---------- trimestres ---------- */
  .trimestres {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 26px;
    margin-bottom: 14px;
  }

  .encabezado-bloque {
    margin-bottom: 24px;
  }
  .encabezado-bloque h3 {
    font-size: 20px;
    margin-bottom: 6px;
  }
  .ps {
    font-size: 15px;
    color: var(--muted);
    max-width: 68ch;
  }
  .ps strong {
    color: var(--coral);
    font-weight: 600;
  }

  .qgrid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .q {
    background: var(--ink2);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 18px;
  }
  .q.perdidas {
    border-color: rgba(208, 132, 104, 0.35);
    background: rgba(208, 132, 104, 0.05);
  }

  .qcabecera {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 14px;
  }
  .qt {
    font-size: 15px;
    color: var(--muted);
  }
  .qebitda {
    font-size: 15px;
    white-space: nowrap;
  }
  .verde {
    color: var(--pulso);
  }
  .coral {
    color: var(--coral);
  }

  .barra {
    height: 64px;
    display: flex;
    align-items: flex-end;
    margin-bottom: 12px;
  }
  .barra span {
    display: block;
    width: 100%;
    height: var(--alto);
    border-radius: 4px;
    background: linear-gradient(180deg, var(--pulso), var(--pulso-deep));
    opacity: 0.75;
  }
  .q.perdidas .barra span {
    background: linear-gradient(180deg, var(--coral), #8a5040);
  }

  .qingresos {
    font-size: 15px;
    margin-bottom: 4px;
  }
  .qnota {
    font-size: 12px;
    color: var(--muted2);
    line-height: 1.45;
  }

  /* ---------- acciones ---------- */
  .acciones {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 24px 26px;
  }
  .acciones ol {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 14px;
  }
  .acciones li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 16px;
    line-height: 1.5;
  }
  .orden {
    font-size: 13px;
    color: var(--pulso);
    padding-top: 3px;
  }

  /* ---------- adaptación ---------- */
  @media (max-width: 980px) {
    .cuerpo {
      grid-template-columns: 1fr;
    }
    .qgrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .qgrid {
      grid-template-columns: 1fr;
    }
    .fila.total .importe {
      font-size: 23px;
    }
    .cuenta {
      padding-inline: 18px;
    }
  }
</style>
