---
import Latido from './Latido.astro';

// v2: la nav ya no son anclas de una sola página larga, son páginas de verdad.
const enlaces = [
  { href: '/', texto: 'Inicio' },
  { href: '/que-hacemos', texto: 'Qué hacemos' },
  { href: '/herramientas', texto: 'Herramientas' },
  { href: '/contacto', texto: 'Contacto' },
];

const actual = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="nav">
  <div class="wrap fila">
    <a href="/" class="marca" aria-label="Pulso, inicio">
      <Latido tamano={26} />
      <span class="serif nombre">Pulso</span>
    </a>

    <nav class="enlaces" aria-label="Principal">
      {
        enlaces.map((e) => (
          <a href={e.href} class:list={[{ activo: actual === e.href }]} aria-current={actual === e.href ? 'page' : undefined}>
            {e.texto}
          </a>
        ))
      }
    </nav>

    <a href="/contacto" class="btn compacto">Contacta</a>
  </div>
  <div class="filo" aria-hidden="true"></div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(7, 18, 13, 0.82);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .filo {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(92, 227, 163, 0.5), transparent);
  }

  .fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 15px;
  }

  .marca {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .nombre {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .enlaces {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .enlaces a {
    color: var(--muted);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    border-radius: 100px;
    padding: 9px 16px;
    white-space: nowrap;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .enlaces a:hover {
    color: var(--ivory);
  }
  .enlaces a.activo {
    color: var(--pulso);
    background: rgba(92, 227, 163, 0.12);
    font-weight: 600;
  }

  .btn.compacto {
    padding: 11px 20px;
    font-size: 14px;
    flex-shrink: 0;
  }

  /* Pantalla intermedia: la fila sigue cabiendo, solo se aprieta. */
  @media (max-width: 1060px) {
    .fila {
      gap: 16px;
    }
    .enlaces a {
      font-size: 14px;
      padding-inline: 13px;
    }
  }

  /* Movil: tres lineas. Logo, menu entero y boton. Nada de desplazar a los
     lados para descubrir que habia mas enlaces. */
  @media (max-width: 700px) {
    .fila {
      flex-direction: column;
      gap: 10px;
      padding-block: 13px;
    }
    .enlaces {
      flex-wrap: wrap;
      justify-content: center;
      gap: 4px 6px;
    }
    .btn.compacto {
      padding: 10px 26px;
    }
  }
</style>
