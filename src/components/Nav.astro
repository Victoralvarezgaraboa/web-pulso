---
import Latido from './Latido.astro';

// v2: la nav ya no son anclas de una sola página larga, son páginas de verdad.
//
// «Pruébalas» es la excepción: no es una página, es la pestaña de demos de
// /herramientas. Está aquí arriba a propósito. Metidas dentro de la página de
// herramientas no las veía nadie, y son lo más convincente que tenemos porque
// se comprueban solas. Marcada con el punto vivo para que se distinga de las
// otras cuatro, que son secciones y no una invitación.
const enlaces = [
  { href: '/', texto: 'Inicio' },
  { href: '/que-hacemos', texto: 'Qué hacemos' },
  { href: '/herramientas', texto: 'Herramientas' },
  { href: '/herramientas#demos', texto: 'Pruébalas', vivo: true },
  { href: '/contacto', texto: 'Contacto' },
];

const actual = Astro.url.pathname.replace(/\/$/, '') || '/';

// Los enlaces con ancla nunca se marcan como página actual: /herramientas y
// /herramientas#demos comparten ruta, y se encenderían las dos a la vez.
const esActual = (e: (typeof enlaces)[number]) => !e.vivo && actual === e.href;
---

<header class="nav">
  <div class="wrap fila">
    <a href="/" class="marca" aria-label="Pulso, inicio">
      <Latido tamano={26} />
      <span class="serif nombre">Pulso</span>
    </a>

    <nav class="enlaces" aria-label="Principal">
      {
        enlaces.map((e) => (
          <a
            href={e.href}
            class:list={[{ activo: esActual(e), vivo: e.vivo }]}
            aria-current={esActual(e) ? 'page' : undefined}
          >
            {e.vivo && <span class="punto" aria-hidden="true" />}
            {e.texto}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="filo" aria-hidden="true"></div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(7, 18, 13, 0.82);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .filo {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(92, 227, 163, 0.5), transparent);
  }

  /* Dos piezas, no tres: el logo a la izquierda y el menu pegado a la
     derecha. Antes habia ademas un boton "Contacta" que llevaba al mismo
     sitio que la pestaña "Contacto"; sobraba. */
  .fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 15px;
  }

  .marca {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .nombre {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .enlaces {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .enlaces a {
    color: var(--muted);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    border-radius: 100px;
    padding: 9px 16px;
    white-space: nowrap;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .enlaces a:hover {
    color: var(--ivory);
  }
  .enlaces a.activo {
    color: var(--pulso);
    background: rgba(92, 227, 163, 0.12);
    font-weight: 600;
  }

  /* El mismo filo claro que llevan la pestaña y las tarjetas de demo: pide
     el clic con relieve, no con otro color más. */
  .enlaces a.vivo {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--ivory);
    border: 1px solid rgba(236, 239, 234, 0.28);
    box-shadow: inset 0 1px 0 rgba(236, 239, 234, 0.42);
    padding-block: 8px;
  }
  .enlaces a.vivo:hover {
    border-color: rgba(236, 239, 234, 0.55);
    box-shadow: inset 0 1px 0 rgba(236, 239, 234, 0.7);
  }
  .punto {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--pulso);
    box-shadow: 0 0 8px var(--pulso);
    flex-shrink: 0;
    animation: latir 2s ease-in-out infinite;
  }
  @keyframes latir {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.35;
      transform: scale(0.72);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .punto {
      animation: none;
    }
  }

  /* Pantalla intermedia: la fila sigue cabiendo, solo se aprieta. */
  @media (max-width: 1060px) {
    .fila {
      gap: 16px;
    }
    .enlaces a {
      font-size: 14px;
      padding-inline: 13px;
    }
  }

  /* Movil: dos lineas, el logo arriba y el menu debajo repartido en las que
     hagan falta. Nada de desplazar a los lados para descubrir que habia mas
     enlaces. */
  @media (max-width: 700px) {
    .fila {
      flex-direction: column;
      gap: 10px;
      padding-block: 13px;
    }
    .enlaces {
      flex-wrap: wrap;
      justify-content: center;
      gap: 4px 6px;
    }
  }
</style>
