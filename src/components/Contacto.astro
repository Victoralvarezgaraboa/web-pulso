---
import { contacto, enlaceWhatsapp, enlaceEmail } from '../data/pulso';
---

<section id="contacto">
  <div class="wrap">
    <p class="sec-label">03 · Contacto</p>
    <h2>Cuéntanos qué tarea te roba el tiempo.</h2>
    <p class="bajada">
      Una conversación, sin compromiso. Nos dices dónde se te escapa el control y te decimos si Pulso
      te sirve — o si no.
    </p>

    <div class="rejilla">
      {
        enlaceWhatsapp && (
          <a href={enlaceWhatsapp} target="_blank" rel="noopener" class="via">
            <p class="rotulo mono">WhatsApp</p>
            <p class="dato serif">{contacto.telefonoVisible}</p>
          </a>
        )
      }
      {
        enlaceEmail && (
          <a href={enlaceEmail} class="via">
            <p class="rotulo mono">Correo</p>
            <p class="dato serif corto">{contacto.email}</p>
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  section {
    border-top: none;
  }

  h2 {
    max-width: 20ch;
    margin-bottom: 20px;
    font-size: clamp(34px, 6vw, 60px);
  }

  .bajada {
    font-size: 18px;
    color: var(--muted);
    max-width: 50ch;
    margin-bottom: 44px;
    text-wrap: pretty;
  }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 18px;
    max-width: 820px;
  }

  .via {
    display: block;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 30px;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }
  .via:hover {
    border-color: var(--pulso);
  }

  .rotulo {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--pulso);
    margin-bottom: 14px;
  }

  .dato {
    font-size: 24px;
    font-weight: 500;
  }
  .dato.corto {
    font-size: 20px;
    word-break: break-all;
  }
</style>
