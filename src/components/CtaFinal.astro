---
import { contacto, enlaceEmail, enlaceWhatsapp } from '../data/pulso';
---

<section id="contacto" class="cierre">
  <div class="wrap">
    <svg
      class="ecg"
      viewBox="0 0 420 60"
      fill="none"
      preserveAspectRatio="xMidYMid meet"
      aria-hidden="true"
      data-trazo-scroll
    >
      <path
        d="M0 30 H130 L150 30 L166 8 L186 52 L206 18 L222 30 H420"
        stroke="var(--pulso)"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        opacity="0.8"
        data-trazo></path>
    </svg>

    <h2 data-anim>Empecemos por lo que te quita el sueño</h2>
    <p class="bajada" data-anim>
      Cuéntanoslo en una llamada de veinte minutos. Si no podemos ayudarte, te lo diremos ahí mismo.
    </p>

    <div class="acciones" data-anim-grupo>
      {
        enlaceEmail ? (
          <a href={enlaceEmail} class="btn">
            Escríbenos
          </a>
        ) : (
          <span class="btn pendiente" title="Falta el email en src/data/pulso.ts">
            Escríbenos · {contacto.email}
          </span>
        )
      }
      {
        enlaceWhatsapp ? (
          <a href={enlaceWhatsapp} class="btn ghost" rel="noopener">
            WhatsApp
          </a>
        ) : (
          <span class="btn ghost pendiente" title="Falta el teléfono en src/data/pulso.ts">
            WhatsApp · {contacto.whatsapp}
          </span>
        )
      }
    </div>
  </div>
</section>

<style>
  .cierre {
    text-align: center;
    padding-block: clamp(80px, 12vw, 120px);
  }

  .ecg {
    width: min(420px, 90%);
    height: auto;
    display: block;
    margin: 0 auto 34px;
  }

  h2 {
    font-size: clamp(34px, 6vw, 60px);
    max-width: 16ch;
    margin: 0 auto 22px;
    line-height: 1.05;
    text-wrap: balance;
  }

  .bajada {
    font-size: 19px;
    color: var(--muted);
    max-width: 50ch;
    margin: 0 auto 40px;
    text-wrap: pretty;
  }

  .acciones {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Estado visible mientras el dato de contacto siga sin rellenar */
  .pendiente {
    cursor: not-allowed;
    opacity: 0.65;
  }

  @media (max-width: 520px) {
    .acciones {
      flex-direction: column;
      align-items: stretch;
    }
    .acciones > * {
      justify-content: center;
    }
  }
</style>
