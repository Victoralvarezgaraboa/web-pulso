---
/**
 * Envoltorio de las páginas legales. Solo pone la caja y la tipografía: el
 * contenido lo trae cada página por el slot.
 *
 * Va aparte porque el aviso legal y la privacidad comparten forma, y porque un
 * texto legal se lee distinto que el resto del sitio: columna estrecha, más
 * interlineado y sin nada que distraiga.
 */
interface Props {
  titulo: string;
  entradilla: string;
  actualizado: string;
}

const { titulo, entradilla, actualizado } = Astro.props;
---

<section class="legal">
  <div class="wrap">
    <p class="sec-label">Legal</p>
    <h1>{titulo}</h1>
    <p class="entradilla">{entradilla}</p>
    <p class="fecha mono">Última actualización: {actualizado}</p>

    <div class="cuerpo">
      <slot />
    </div>
  </div>
</section>

<style>
  .legal {
    border-top: none;
  }

  h1 {
    font-family: var(--serif);
    font-size: clamp(34px, 6vw, 54px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin-bottom: 18px;
    text-wrap: balance;
  }

  .entradilla {
    font-size: 18px;
    color: var(--muted);
    max-width: 60ch;
    text-wrap: pretty;
  }

  .fecha {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted2);
    margin-top: 18px;
    padding-bottom: 26px;
    border-bottom: 1px solid var(--line);
  }

  /* El texto legal se lee de arriba abajo y en columna estrecha. Todo lo que
     va dentro del slot se estiliza desde aquí con :global, porque el marcado
     lo escribe la página y no este componente. */
  .cuerpo {
    max-width: 68ch;
    margin-top: 40px;
  }

  .cuerpo :global(h2) {
    font-family: var(--serif);
    font-size: 25px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 46px 0 14px;
    text-wrap: balance;
  }
  .cuerpo :global(h2:first-child) {
    margin-top: 0;
  }

  .cuerpo :global(h3) {
    font-size: 17px;
    font-weight: 600;
    margin: 28px 0 8px;
  }

  .cuerpo :global(p) {
    font-size: 16.5px;
    line-height: 1.68;
    color: var(--muted);
    margin-bottom: 15px;
    text-wrap: pretty;
  }
  .cuerpo :global(strong) {
    color: var(--ivory);
    font-weight: 600;
  }
  .cuerpo :global(a) {
    color: var(--pulso);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cuerpo :global(ul) {
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
  }
  .cuerpo :global(li) {
    position: relative;
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--muted);
    padding-left: 22px;
    margin-bottom: 9px;
  }
  .cuerpo :global(li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.63em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--pulso);
    opacity: 0.55;
  }

  /* Ficha de datos identificativos: pares dato/valor, no prosa. */
  .cuerpo :global(dl) {
    display: grid;
    grid-template-columns: minmax(140px, auto) 1fr;
    gap: 12px 24px;
    margin: 0 0 18px;
    padding: 24px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .cuerpo :global(dt) {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted2);
    padding-top: 3px;
  }
  .cuerpo :global(dd) {
    margin: 0;
    font-size: 16px;
    color: var(--ivory);
  }

  /* Los huecos pendientes se ven, a propósito, para que no se cuelen. */
  .cuerpo :global(.hueco) {
    font-family: var(--mono);
    font-size: 14px;
    color: var(--amber);
    border: 1px dashed rgba(230, 181, 103, 0.45);
    border-radius: 6px;
    padding: 2px 8px;
  }

  .cuerpo :global(.aviso) {
    background: rgba(230, 181, 103, 0.07);
    border: 1px solid rgba(230, 181, 103, 0.35);
    border-radius: var(--radius);
    padding: 22px 26px;
    margin: 30px 0;
  }
  .cuerpo :global(.aviso p) {
    margin-bottom: 0;
    color: var(--ivory);
    font-size: 15.5px;
  }
  .cuerpo :global(.aviso p + p) {
    margin-top: 11px;
  }
  .cuerpo :global(.aviso .rotulo) {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--amber);
    margin-bottom: 10px;
  }

  @media (max-width: 560px) {
    .cuerpo :global(dl) {
      grid-template-columns: 1fr;
      gap: 4px;
      padding: 20px;
    }
    .cuerpo :global(dt) {
      margin-top: 12px;
    }
    .cuerpo :global(dt:first-child) {
      margin-top: 0;
    }
  }
</style>
