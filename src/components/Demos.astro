---
import { demos, enlaceDemo, muroDemos } from '../data/herramientas';

const paneles = demos.filter((d) => d.tipo === 'panel');
const utiles = demos.filter((d) => d.tipo === 'herramienta');

const grupos = [
  {
    titulo: 'Paneles de cierre',
    cuando: 'Lo que consultas una vez al mes',
    lista: paneles,
  },
  {
    titulo: 'Herramientas de trabajo',
    cuando: 'Lo que usas cada día',
    lista: utiles,
  },
];
---

<section id="demos">
  <div class="wrap">
    <p class="sec-label" data-anim>05 · Demos</p>

    <div class="encabezado">
      <div>
        <h2 data-anim>No te fíes de nosotros. Ábrelas.</h2>
        <p class="bajada" data-anim>
          Seis demos funcionando ahora mismo, con datos de ejemplo. Son las mismas herramientas que
          usan los clientes. Si algo no te encaja, lo verás en dos minutos y nos ahorramos los dos
          una reunión.
        </p>
      </div>

      <ul class="sinfriccion" data-anim>
        <li>Sin registro</li>
        <li>Sin dejar el correo</li>
        <li>Sin instalar nada</li>
      </ul>
    </div>

    {
      grupos.map((g) => (
        <div class="grupo">
          <div class="titulo-grupo" data-anim>
            <h3 class="serif">{g.titulo}</h3>
            <span class="cuando mono">{g.cuando}</span>
          </div>

          <div class="rejilla" data-anim-grupo>
            {g.lista.map((d) => (
              <a class="demo" href={enlaceDemo(d)} target="_blank" rel="noopener">
                <div class="lienzo">
                  {d.tipo === 'panel' ? (
                    /* Insinúa un panel: barras con un trimestre en rojo */
                    <svg viewBox="0 0 200 96" fill="none" aria-hidden="true">
                      <rect x="12" y="14" width="52" height="5" rx="2.5" fill="currentColor" opacity=".28" />
                      <rect x="12" y="60" width="24" height="26" rx="3" fill="var(--pulso)" opacity=".55" />
                      <rect x="46" y="48" width="24" height="38" rx="3" fill="var(--pulso)" opacity=".55" />
                      <rect x="80" y="68" width="24" height="18" rx="3" fill="var(--coral)" opacity=".7" />
                      <rect x="114" y="42" width="24" height="44" rx="3" fill="var(--pulso)" opacity=".55" />
                      <path
                        d="M12 34 L46 30 L80 38 L114 24 L148 18 L188 12"
                        stroke="var(--pulso)"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <rect x="152" y="60" width="36" height="26" rx="3" fill="currentColor" opacity=".12" />
                    </svg>
                  ) : (
                    /* Insinúa un presupuesto: líneas de partida y un total */
                    <svg viewBox="0 0 200 96" fill="none" aria-hidden="true">
                      <rect x="12" y="12" width="60" height="5" rx="2.5" fill="currentColor" opacity=".28" />
                      {[30, 44, 58].map((y) => (
                        <>
                          <rect x="12" y={y} width="96" height="4" rx="2" fill="currentColor" opacity=".18" />
                          <rect x="150" y={y} width="38" height="4" rx="2" fill="currentColor" opacity=".28" />
                        </>
                      ))}
                      <rect x="12" y="74" width="52" height="5" rx="2.5" fill="var(--pulso)" opacity=".6" />
                      <rect x="138" y="72" width="50" height="9" rx="3" fill="var(--pulso)" opacity=".55" />
                    </svg>
                  )}

                  <span class="envivo">
                    <span class="punto" />
                    en vivo
                  </span>
                </div>

                <div class="texto">
                  <span class="sector mono">{d.sector}</span>
                  <h4>{d.nombre}</h4>
                  <p class="gancho">{d.gancho}</p>

                  <p class="dentro">
                    <span class="etiqueta mono">Dentro verás</span>
                    {d.dentro}
                  </p>

                  <span class="abrir">
                    Abrir demo
                    <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path
                        d="M6 3h7v7M13 3L4 12"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))
    }

    <div class="cierre" data-anim>
      <p>
        Las seis viven juntas en <a href={muroDemos} target="_blank" rel="noopener">el muro de Pulso</a>.
        Los datos son inventados; el funcionamiento, no.
      </p>
      <a href="#contacto" class="btn">Quiero la mía con mis datos</a>
    </div>
  </div>
</section>

<style>
  .encabezado {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    margin-bottom: 56px;
    flex-wrap: wrap;
  }

  h2 {
    max-width: 18ch;
    margin-bottom: 20px;
  }

  .bajada {
    font-size: 18px;
    color: var(--muted);
    max-width: 58ch;
    text-wrap: pretty;
  }

  /* Los tres frenos habituales de una demo, desactivados a la vista */
  .sinfriccion {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-shrink: 0;
  }
  .sinfriccion li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    color: var(--ivory);
    white-space: nowrap;
  }
  .sinfriccion li::before {
    content: '';
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1.5px solid var(--pulso);
    background:
      linear-gradient(45deg, transparent 45%, var(--pulso) 45%, var(--pulso) 55%, transparent 55%),
      linear-gradient(-45deg, transparent 45%, var(--pulso) 45%, var(--pulso) 55%, transparent 55%);
    flex-shrink: 0;
  }

  /* ---------- grupos ---------- */
  .grupo {
    margin-bottom: 46px;
  }

  .titulo-grupo {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }
  .titulo-grupo h3 {
    font-size: 26px;
    color: var(--pulso);
  }
  .cuando {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted2);
  }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
    gap: 18px;
  }

  /* ---------- tarjeta ---------- */
  .demo {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }
  .demo:hover {
    border-color: rgba(92, 227, 163, 0.4);
    transform: translateY(-4px);
    box-shadow: 0 22px 50px rgba(0, 0, 0, 0.35);
  }

  .lienzo {
    position: relative;
    background: var(--ink2);
    border-bottom: 1px solid var(--line);
    padding: 22px 24px;
    color: var(--ivory);
  }
  .lienzo svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .envivo {
    position: absolute;
    top: 14px;
    right: 16px;
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .punto {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--pulso);
    animation: latir 2.2s ease-in-out infinite;
  }
  @keyframes latir {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.35;
      transform: scale(0.75);
    }
  }

  .texto {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .sector {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted2);
    margin-bottom: 8px;
  }

  .texto h4 {
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.2;
    margin-bottom: 10px;
  }

  .gancho {
    font-size: 15px;
    color: var(--muted);
    margin-bottom: 16px;
    text-wrap: pretty;
  }

  /* Decir qué hay dentro ANTES del clic: quien entra sabiendo qué busca,
     se queda; quien entra a ciegas, rebota. */
  .dentro {
    font-size: 14px;
    color: var(--muted2);
    line-height: 1.55;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    margin-bottom: 18px;
    margin-top: auto;
  }
  .etiqueta {
    display: block;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pulso);
    margin-bottom: 5px;
  }

  .abrir {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--pulso);
  }
  .demo:hover .abrir svg {
    transform: translate(2px, -2px);
  }
  .abrir svg {
    transition: transform 0.25s ease;
  }

  /* ---------- cierre ---------- */
  .cierre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    background: var(--card2);
    border: 1px solid rgba(92, 227, 163, 0.25);
    border-radius: var(--radius);
    padding: 28px 34px;
    margin-top: 8px;
  }
  .cierre p {
    font-size: 16px;
    color: var(--muted);
    max-width: 56ch;
  }
  .cierre a:not(.btn) {
    color: var(--pulso);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 600px) {
    .cierre {
      flex-direction: column;
      align-items: stretch;
    }
    .cierre :global(.btn) {
      justify-content: center;
    }
  }
</style>
