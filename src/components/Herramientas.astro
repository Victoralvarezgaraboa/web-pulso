---
import { herramientas } from '../data/herramientas';

const familias = ['Generadores', 'Operación', 'Análisis'] as const;

const descripcionFamilia: Record<(typeof familias)[number], string> = {
  Generadores: 'Para cerrar trabajos más rápido y sin regalar margen',
  Operación: 'Para que el dato entre solo, en el sitio donde se genera',
  Análisis: 'Para saber, cada mes, dónde estás',
};
---

<section id="herramientas">
  <div class="wrap">
    <p class="sec-label" data-anim>04 · Herramientas</p>
    <h2 data-anim>No solo te contamos el problema. Te damos la herramienta.</h2>
    <p class="bajada" data-anim>
      Aquí es donde Pulso deja de parecerse a una asesoría. Cuando el cierre mensual detecta que se
      te va el margen presupuestando a ojo, no te mandamos un informe: te construimos el generador de
      presupuestos con tus precios dentro. <strong>Todas están en producción, usándose a diario.</strong>
    </p>

    {
      familias.map((familia) => (
        <div class="familia">
          <div class="titulo-familia" data-anim>
            <h3 class="serif">{familia}</h3>
            <p>{descripcionFamilia[familia]}</p>
          </div>

          <div class="rejilla" data-anim-grupo>
            {herramientas
              .filter((h) => h.familia === familia)
              .map((h) => (
                <article class="herramienta">
                  {h.destacado && <span class="etiqueta mono">{h.destacado}</span>}
                  <h4>{h.nombre}</h4>
                  <p class="que">{h.que}</p>
                  <p class="detalle">{h.detalle}</p>
                </article>
              ))}
          </div>
        </div>
      ))
    }

    <p class="cierre" data-anim>
      ¿Tu negocio necesita una que no está en esta lista? Es exactamente así como nacieron todas
      las demás.
    </p>
  </div>
</section>

<style>
  h2 {
    max-width: 24ch;
    margin-bottom: 20px;
  }

  .bajada {
    font-size: 18px;
    color: var(--muted);
    max-width: 66ch;
    margin-bottom: 60px;
    text-wrap: pretty;
  }
  .bajada strong {
    color: var(--ivory);
    font-weight: 600;
  }

  .familia {
    margin-bottom: 48px;
  }

  .titulo-familia {
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }
  .titulo-familia h3 {
    font-size: 26px;
    color: var(--pulso);
  }
  .titulo-familia p {
    font-size: 15px;
    color: var(--muted2);
  }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
  }

  .herramienta {
    position: relative;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
    transition: border-color 0.25s ease, transform 0.25s ease, background 0.25s ease;
  }
  .herramienta:hover {
    border-color: rgba(92, 227, 163, 0.35);
    background: var(--card2);
    transform: translateY(-3px);
  }

  .etiqueta {
    display: inline-block;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pulso);
    border: 1px solid rgba(92, 227, 163, 0.35);
    border-radius: 100px;
    padding: 4px 11px;
    margin-bottom: 14px;
  }

  .herramienta h4 {
    font-family: var(--serif);
    font-size: 21px;
    font-weight: 500;
    line-height: 1.2;
    margin-bottom: 10px;
  }

  .que {
    font-size: 16px;
    color: var(--ivory);
    margin-bottom: 12px;
  }

  .detalle {
    font-size: 15px;
    color: var(--muted);
    text-wrap: pretty;
  }

  .cierre {
    font-family: var(--serif);
    font-size: clamp(20px, 3vw, 26px);
    color: var(--ivory);
    max-width: 30ch;
    margin-top: 20px;
    line-height: 1.35;
  }
</style>
