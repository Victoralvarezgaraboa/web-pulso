---
import Latido from './Latido.astro';

const anio = new Date().getFullYear();
---

<footer>
  <div class="wrap fila">
    <p class="marca">
      <Latido tamano={18} color="var(--muted2)" />
      <span>Pulso · el pulso de tu negocio</span>
    </p>
    <p class="legal mono">
      <a href="#">[AVISO LEGAL]</a> · <a href="#">[PRIVACIDAD]</a> · {anio}
    </p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding-block: 34px;
  }

  .fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .marca {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 14px;
    color: var(--muted2);
  }

  .legal {
    font-size: 12px;
    color: var(--muted2);
  }
  .legal a {
    color: inherit;
    text-decoration: none;
  }
  .legal a:hover {
    color: var(--muted);
  }
</style>
