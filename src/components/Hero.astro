---
// v2: la portada solo dice qué hacemos y qué vendemos. Nada más.
// El resto del contenido vive en sus propias páginas, no apilado aquí debajo.
const pasos = [
  { n: '01', que: 'Escuchamos tu forma de trabajar' },
  { n: '02', que: 'Ordenamos compras y ventas' },
  { n: '03', que: 'Trabajamos tus albaranes' },
  { n: '04', que: 'Te devolvemos una visión clara' },
];
---

<section class="hero">
  <div class="wrap">
    <p class="kicker mono">Control claro para negocios pequeños</p>

    <h1 class="titular">
      <span class="linea">Tu negocio.</span>
      <span class="linea ultima">
        Tus datos, claros.
        <span class="latido" aria-hidden="true"></span>
      </span>
    </h1>

    <svg class="ecg" viewBox="0 0 640 80" fill="none" preserveAspectRatio="xMinYMid meet" aria-hidden="true">
      <path
        d="M0 40 H150 L172 40 L190 12 L212 68 L236 26 L256 40 H392 L414 40 L430 20 L450 60 L468 40 H640"
        stroke="var(--pulso)"
        stroke-width="2.6"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>

    <p class="entrada">
      Construimos la herramienta que tu oficio necesita y convertimos tus números en una visión clara
      del negocio.
    </p>
    <p class="matiz">
      Tú nos cuentas el problema. Nosotros hacemos la pieza a medida, ordenamos el dato y te enseñamos
      qué está pasando.
    </p>

    <div class="acciones">
      <a href="/contacto" class="btn">
        Cuéntanos tu problema
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
      <a href="/herramientas" class="btn ghost">Ver las herramientas</a>
    </div>

    <div class="rejilla">
      {
        pasos.map((p) => (
          <div class="paso">
            <span class="cifra mono">{p.n}</span>
            <span class="que">{p.que}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(56px, 9vw, 104px) clamp(80px, 10vw, 120px);
    border-top: none;
  }

  .kicker {
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 28px;
  }

  .titular {
    font-size: clamp(48px, 9.5vw, 116px);
    font-weight: 600;
    letter-spacing: -0.028em;
    line-height: 0.94;
    margin-bottom: 8px;
  }
  .linea {
    display: block;
  }
  .ultima {
    position: relative;
    display: inline-block;
  }

  .latido {
    display: inline-block;
    width: 0.1em;
    height: 0.1em;
    border-radius: 50%;
    background: var(--pulso);
    box-shadow: 0 0 26px var(--pulso);
    margin-left: 0.07em;
    animation: latir 2.2s ease-in-out infinite;
  }
  @keyframes latir {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.8);
    }
  }

  .ecg {
    display: block;
    width: min(640px, 100%);
    height: auto;
    margin-block: clamp(22px, 4vw, 34px) clamp(20px, 3vw, 30px);
  }

  .entrada {
    font-size: clamp(19px, 2.5vw, 24px);
    line-height: 1.5;
    max-width: 36ch;
    margin-bottom: 16px;
    text-wrap: pretty;
  }

  .matiz {
    font-size: 17px;
    color: var(--muted);
    max-width: 46ch;
    margin-bottom: 34px;
    text-wrap: pretty;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: clamp(64px, 9vw, 104px);
  }

  /* Los cuatro pasos: una sola rejilla con borde, sin franja a sangre */
  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .paso {
    background: var(--ink2);
    padding: 26px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cifra {
    font-size: clamp(22px, 3vw, 30px);
    color: var(--pulso);
    line-height: 1;
  }

  .que {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.45;
  }

  @media (max-width: 520px) {
    .acciones {
      flex-direction: column;
      align-items: stretch;
    }
    .acciones :global(.btn) {
      justify-content: center;
      padding-block: 17px;
    }
  }
</style>
